      "typeVersion": 2,
      "position": [448, 150],
      "parameters": {
        "jsCode": "const j = $input.item.json;\nconst agentOutput = j.output || {};\n\nreturn {\n  json: {\n    output: {\n      ...agentOutput,\n      email_id: j.email_id,\n      customer_email: j.customer_email\n    }\n  }\n};",
