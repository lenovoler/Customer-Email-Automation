    {
      "id": "1c852f15-ea8b-48b3-bc44-761a09e055b2",
      "name": "Guard: Filter Spam/Autoreply",
      "type": "n8n-nodes-base.filter",
      "typeVersion": 2.3,
      "position": [100, 0],
      "parameters": {"conditions": {"combinator": "and", "conditions": [
        {"leftValue": "={{ $json.from.value[0].address }}", "operator": {"operation": "notContains", "type": "string"}, "rightValue": "noreply"},
        {"leftValue": "={{ $json.from.value[0].address }}", "operator": {"operation": "notContains", "type": "string"}, "rightValue": "no-reply"},
        {"leftValue": "={{ $json.from.value[0].address }}", "operator": {"operation": "notContains", "type": "string"}, "rightValue": "mailer-daemon"},
        {"leftValue": "={{ $json.from.value[0].address }}", "operator": {"operation": "notContains", "type": "string"}, "rightValue": "postmaster"}
      ], "options": {"caseSensitive": false, "leftValue": "", "typeValidation": "loose"}}}
